# Client PDF Unlocker Configuration
APP_NAME="Client PDF Unlocker"
APP_ENV=production
DEBUG=false

# Security & Session
SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# File Upload & Job Limits
MAX_FILE_SIZE_MB=50
MAX_FILES_PER_JOB=500
WORKER_COUNT=4
RETENTION_MINUTES=30
TEMP_DIR=temp_jobs

# Database
DATABASE_URL=sqlite:///./data/pdf_unlocker.db

# Rate Limiting
RATE_LIMIT_LOGIN="10/minute"
RATE_LIMIT_UNLOCK="20/minute"

# Initial Default Users (Created on first run)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_STAFF_USERNAME=staff
DEFAULT_STAFF_PASSWORD=Staff@12345
